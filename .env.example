# Copy this file to .env and fill in real values. Never commit .env.

# dev | prod
APP_ENV=dev

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
# seconds
JWT_EXPIRATION=86400
# clientID in settings.ssoConfig used by POST /auth/partner/user when no provider is sent
PARTNER_SSO_CLIENT_ID=

# ---- Gateway + gRPC services ----
APIGATEWAY_PORT=8000
# Comma separated domains allowed by CORS (localhost is always allowed), subdomains included
CORS_ALLOWED_DOMAINS=example.com
AUTH_GRPC_URL=localhost:8010
NOTIFY_GRPC_URL=localhost:8020
ADMINISTRATION_GRPC_URL=localhost:8030
ASSESSMENT_GRPC_URL=localhost:8040
CLASSROOM_GRPC_URL=localhost:8050
COURSE_GRPC_URL=localhost:8060
QUESTION_BANK_GRPC_URL=localhost:8070
ECOMMERCE_GRPC_URL=localhost:8071
ATTEMPT_GRPC_URL=localhost:8090

# ---- MongoDB (one database per instance) ----
MONGO_URI_STAGING=mongodb://127.0.0.1:27017/stagingdb
MONGO_URI_PROCTORING=mongodb://127.0.0.1:27017/newstagingdb
ORIGIN_STAGING=http://localhost:4200
ORIGIN_PROCTORING=http://localhost:4201
# Or define all instances as JSON (overrides the two above):
# DB_INSTANCES=[{"instancekey":"staging","uri":"mongodb://127.0.0.1:27017/stagingdb","assets":"default","origin":"http://localhost:4200"}]
ADMIN_MONGO_URI=mongodb://127.0.0.1:27017/admin
# Optional extra database
GREENT_MONGO_URI=
GREENT_INSTANCEKEY=

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=
REDIS_USER=default
REDIS_URI=redis://127.0.0.1:6379
# true = in-memory mock (no Redis needed, queues will not work)
REDIS_ISMOCK=false
# empty | cluster | masterSlaves
REDIS_TYPE=

# ---- Email (notify service) ----
SMTP_USER=no-reply@example.com
MAILTRAP_USER=
MAILTRAP_PASSWORD=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Comma separated recipient lists
SUPPORT_EMAIL=
FEEDBACK_CC_EMAILS=
HOST_RATE_EMAILS=
TEST_MAIL_TO=

# ---- AWS ----
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=ap-south-1
S3_USER_ASSETS_BUCKET=
S3_USER_ASSETS_BASE_URL=
S3_FACE_REG_BUCKET=
S3_FACE_REG_BASE_URL=

# ---- Other integrations (optional) ----
BASE_URL=http://localhost:4200/
APP_NAME=assessmentPlatform
SESSION_SECRET=
APP_SECRET=
BOARDINFINITY_SECRET_KEY=
ADAPTIVE_API_URL=
# Content extractor service used for supported file profiles
EXTRACTOR_API_URL=
# S3 key prefix for uploaded user assets
S3_KEY_PREFIX=
REPORT_API_URL=
CODE_RUNNER_URL=http://localhost:9100/
CCAVENUE_HANDLER_URL=
NIIT_ATTEMPT_URL=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_NUMBER=
SEND_SMS=false
TURN_SERVER=
TURN_SECRET=
GCM_SERVER_KEY=
DEBUG_MODE=true

# ---- Video streaming ----
SSL_KEY_PATH=apps/video-streaming/ssl/key.pem
SSL_CERT_PATH=apps/video-streaming/ssl/cert.pem
WEBRTC_TRANSPORT_IP=0.0.0.0
WEBRTC_TRANSPORT_ANNOUNCED_IP=127.0.0.1

# ---- Rate limiting ----
# Requests per minute per IP across the API, and for login / password reset
THROTTLE_LIMIT=600
THROTTLE_TTL=60000
LOGIN_THROTTLE_LIMIT=10
# Set to false only when the gateway is exposed directly, without a reverse proxy
TRUST_PROXY=true
